<Project>
  <Import Project="$(MSBuildThisFileDirectory)NativeUI.MacOS.targets" Condition="Exists('$(MSBuildThisFileDirectory)NativeUI.MacOS.targets')" />

  <ItemGroup>
    <AdditionalFiles Include="**\*.xaml" Exclude="bin\**;obj\**" />
    <AdditionalFiles Include="**\*.xaml.css" Exclude="bin\**;obj\**;wwwroot\**" />
  </ItemGroup>

  <Target Name="FilterNativeUIPairedCssFiles" BeforeTargets="CoreCompile">
    <ItemGroup>
      <AdditionalFiles Remove="@(AdditionalFiles)"
                       Condition="'%(Extension)' == '.css' and !Exists('%(RootDir)%(Directory)%(Filename)')" />
    </ItemGroup>
  </Target>
  <Target Name="PrepareNativeUISvgInputs">
    <ItemGroup>
      <NativeUISvg Include="@(EmbeddedResource)" Condition="'%(Extension)' == '.svg'">
        <NativeUIResource Condition="'%(LogicalName)' != ''">resource://$(AssemblyName)/%(LogicalName)</NativeUIResource>
        <NativeUIResource Condition="'%(LogicalName)' == ''">resource://$(AssemblyName)/%(Identity)</NativeUIResource>
      </NativeUISvg>
      <NativeUISvg Include="@(Content)" Condition="'%(Extension)' == '.svg'" />
      <_NativeUISvgInput Include="@(NativeUISvg->'%(FullPath)')">
        <NativeUIResource Condition="'%(NativeUISvg.NativeUIResource)' != ''">%(NativeUISvg.NativeUIResource)</NativeUIResource>
        <NativeUIResource Condition="'%(NativeUISvg.NativeUIResource)' == ''">%(NativeUISvg.Identity)</NativeUIResource>
      </_NativeUISvgInput>
    </ItemGroup>
  </Target>

  <Target Name="GetNativeUISvgInputs" DependsOnTargets="PrepareNativeUISvgInputs" Returns="@(_NativeUISvgInput)" />

  <Target Name="CollectNativeUISvgInputs" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;CoreCompile" DependsOnTargets="PrepareNativeUISvgInputs">
    <MSBuild Projects="@(ProjectReference)" Targets="GetNativeUISvgInputs" SkipNonexistentTargets="true" BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="_ReferencedNativeUISvgInput" />
    </MSBuild>
    <ItemGroup>
      <AdditionalFiles Include="@(_NativeUISvgInput);@(_ReferencedNativeUISvgInput)" />
    </ItemGroup>
  </Target>
</Project>
