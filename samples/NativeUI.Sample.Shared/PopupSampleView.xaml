<View xmlns="urn:nativeui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="NativeUI.Sample.PopupSampleView"
      x:DataType="NativeUI.Sample.PopupSampleViewModel"
      Class="popup-page">
    <Text Class="popup-title" Value="Popover" />
    <Text Class="popup-description" Value="A click on the target toggles the popover. Escape and a press outside close it. Focus moves into the content and returns to the target." />

    <View Class="popup-section">
        <Text Class="popup-heading" Value="Target from x:Reference" />
        <Button x:Name="DimensionsButton" Class="popup-trigger" Text="Open popover" />
        <Popover x:Name="DimensionsPopover" Target="{x:Reference DimensionsButton}" HasArrow="True" SideOffset="8">
            <View Class="popup-panel">
                <Text Class="popup-panel-title" Value="Dimensions" />
                <Text Class="popup-muted" Value="Set the dimensions for the layer." />
                <StackPanel Class="popup-field" Orientation="Horizontal">
                    <Text Class="popup-label" Value="Width" />
                    <Input Class="popup-input" Value="100%" />
                </StackPanel>
                <StackPanel Class="popup-field" Orientation="Horizontal">
                    <Text Class="popup-label" Value="Height" />
                    <Input Class="popup-input" Value="25px" />
                </StackPanel>
            </View>
        </Popover>
        <Text x:Name="DimensionsStatus" Class="popup-status" Value="Closed" />
    </View>

    <View Class="popup-section">
        <Text Class="popup-heading" Value="Target in Popover.Target" />
        <Popover Side="Right" Align="Start" HasArrow="True" SideOffset="8">
            <Popover.Target>
                <Button Class="popup-trigger" Text="Open on the right" />
            </Popover.Target>
            <View Class="popup-panel">
                <Text Class="popup-panel-title" Value="Placement" />
                <Text Class="popup-muted" Value="The content flips to the left when the window is too narrow." />
            </View>
        </Popover>
    </View>

    <View Class="popup-section">
        <Text Class="popup-heading" Value="Tooltip" />
        <StackPanel Class="popup-row" Orientation="Horizontal">
            <Button Class="popup-trigger" Text="Save" Tooltip.Text="Save changes" />
            <Button x:Name="ShareButton" Class="popup-trigger" Text="Share" />
            <Tooltip Target="{x:Reference ShareButton}" Side="Bottom" SideOffset="6" HasArrow="True">
                <Text Value="Share this document" />
            </Tooltip>
            <Button x:Name="ArchiveButton" Class="popup-trigger" Text="Archive" />
            <Tooltip Target="{x:Reference ArchiveButton}" Side="Top" SideOffset="6" ArrowPadding="5">
                <Tooltip.Arrow>
                    <View Width="8" Height="8" Class="tooltip-arrow" />
                </Tooltip.Arrow>
                <Tooltip.Content>
                    <Text Value="Move to archive" />
                </Tooltip.Content>
            </Tooltip>
        </StackPanel>
    </View>

    <View Class="popup-section">
        <Text Class="popup-heading" Value="DropdownMenu" />
        <Button x:Name="FileMenuButton" Class="popup-trigger" Text="Options" />
        <DropdownMenu Target="{x:Reference FileMenuButton}" Side="Bottom" Align="Start" SideOffset="4">
            <MenuGroup Header="File">
                <MenuItem Content="New" ShortcutText="Ctrl+N" Command="{Binding NewCommand}" />
                <MenuItem Content="Open" ShortcutText="Ctrl+O" Command="{Binding OpenCommand}" />
                <MenuItem Content="Save" ShortcutText="Ctrl+S" Command="{Binding SaveCommand}" />
            </MenuGroup>
            <MenuSeparator />
            <MenuGroup Header="View">
                <MenuItem Content="Show Toolbar" IsCheckable="True" IsChecked="{Binding ShowToolbar, Mode=TwoWay}" />
                <MenuItem Content="Show Sidebar" IsCheckable="True" IsChecked="{Binding ShowSidebar, Mode=TwoWay}" />
            </MenuGroup>
            <MenuSeparator />
            <MenuItem Content="Export">
                <MenuItem Content="PDF" Command="{Binding ExportCommand}" CommandParameter="PDF" />
                <MenuItem Content="PNG" Command="{Binding ExportCommand}" CommandParameter="PNG" />
                <MenuItem Content="SVG" Command="{Binding ExportCommand}" CommandParameter="SVG" />
            </MenuItem>
            <MenuItem Content="Share">
                <MenuItem Content="Copy Link" />
                <MenuItem Content="More Options">
                    <MenuItem Content="Email" />
                    <MenuItem Content="Messages" />
                </MenuItem>
            </MenuItem>
        </DropdownMenu>
        <Text Class="popup-status" Value="{Binding MenuStatus}" />
        <Text Class="popup-status" Value="Toolbar enabled" IsVisible="{Binding ShowToolbar}" />
        <Text Class="popup-status" Value="Sidebar enabled" IsVisible="{Binding ShowSidebar}" />
    </View>
    <View Class="popup-section">
        <Text Class="popup-heading" Value="ContextMenu" />
        <Text Class="popup-description" Value="Right-click the target, or focus it and press Shift+F10. Nested menus open with Right Arrow and return with Left Arrow." />
        <Button x:Name="ContextMenuTarget" Class="popup-trigger" Text="Right-click here" />
        <ContextMenu Target="{x:Reference ContextMenuTarget}">
            <MenuItem Content="Cut" InputGestureText="⌘X" />
            <MenuItem Content="Copy" InputGestureText="⌘C" />
            <MenuItem Content="Paste" InputGestureText="⌘V" IsEnabled="False" />
            <Separator />
            <MenuItem Content="Open With">
                <MenuItem Content="Text Editor" />
                <MenuItem Content="Browser" />
                <MenuItem Content="More Apps">
                    <MenuItem Content="Preview" />
                    <MenuItem Content="Terminal" />
                </MenuItem>
            </MenuItem>
            <MenuItem Content="Show Hidden Files" IsCheckable="True" />
        </ContextMenu>
    </View>
</View>
