<View xmlns="urn:nativeui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="NativeUI.Sample.FormSampleView"
      x:DataType="NativeUI.Sample.FormSampleViewModel"
      Class="form-page">
    <Text Class="form-heading" Value="Forms and validation" />
    <Text Class="form-description" Value="One MVVM form for desktop and Web. Validation comes from the ViewModel and also works outside a form." />
    <Form x:Name="EditorForm" SubmitCommand="{Binding SaveCommand}">
        <StackPanel Spacing="16">
            <Fieldset Class="form-group">
                <Legend Content="Personal information" />
                <StackPanel Spacing="8">
                    <Label Target="{x:Reference NameInput}" Content="Full name" />
                    <Input x:Name="NameInput" Class="form-input" Required="True" Value="{Binding Name, Mode=TwoWay}" />
                    <Text x:Name="NameErrors" Class="form-error" />
                    <Label Target="{x:Reference EmailInput}" Content="Email" />
                    <Input x:Name="EmailInput" Class="form-input" Required="True" Value="{Binding Email, Mode=TwoWay}" />
                    <Text x:Name="EmailErrors" Class="form-error" />
                </StackPanel>
            </Fieldset>
            <Fieldset Class="form-group">
                <Legend Content="Preferences" />
                <Label>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox IsChecked="{Binding Notifications, Mode=TwoWay}" />
                        <Text Value="Receive notifications" />
                    </StackPanel>
                </Label>
            </Fieldset>
            <Fieldset Class="form-group">
                <Legend>
                    <Label Target="{x:Reference DeliveryGroup}" Content="Delivery" />
                </Legend>
                <RadioGroup x:Name="DeliveryGroup" Spacing="8" Required="True"
                            SelectedValue="{Binding Delivery, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioGroupItem x:Name="StandardDelivery" Value="standard" />
                        <Label Target="{x:Reference StandardDelivery}" Content="Standard delivery" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioGroupItem x:Name="ExpressDelivery" Value="express" />
                        <Label Target="{x:Reference ExpressDelivery}" Content="Express delivery" />
                    </StackPanel>
                </RadioGroup>
                <Text x:Name="DeliveryErrors" Class="form-error" />
            </Fieldset>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Class="form-submit" Type="Submit" Text="Save" />
                <Button Class="form-reset" Type="Reset" Text="Reset" />
            </StackPanel>
            <Text Class="form-status" Value="{Binding Status}" />
        </StackPanel>
    </Form>
</View>
