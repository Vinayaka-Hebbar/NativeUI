<View xmlns="urn:nativeui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="NativeUI.Sample.HelloView"
      x:DataType="NativeUI.Sample.HelloViewModel"
      Class="card">

    <Text x:Name="BadgeText"
          Class="badge"
          Value="{Binding FrameworkBadge}" />

    <Text x:Name="TitleText"
          Class="title"
          Value="{Binding Title}" />

    <Text x:Name="SubtitleText"
          Class="subtitle"
          Value="{Binding Subtitle}" />

    <Text x:Name="StatusText"
          Class="status"
          Value="{Binding LiveStatus}" />

    <Button x:Name="ThemeButton"
            Class="btn-theme"
            Text="{Binding ThemeButtonText}"
            Command="{Binding ToggleThemeCommand}" />

    <!-- The side nav shows one example page at a time; the wheel moves the innermost view that can still scroll. -->
    <Grid Class="shell" Columns="150,*" ColumnSpacing="20">
        <StackPanel Spacing="4">
            <Button x:Name="NavStack" Class="nav-item" Text="StackPanel" />
            <Button x:Name="NavGrid" Class="nav-item" Text="Grid" />
            <Button x:Name="NavScroll" Class="nav-item" Text="Scrolling" />
            <Button x:Name="NavCanvas" Class="nav-item" Text="Canvas" />
            <Button x:Name="NavInput" Class="nav-item" Text="Input" />
            <Button x:Name="NavDialog" Class="nav-item" Text="Dialog" />
            <Button x:Name="NavAnimation" Class="nav-item" Text="Animation" />
            <Button x:Name="NavScene3D" Class="nav-item" Text="3D" />
            <Button x:Name="NavResize" Class="nav-item" Text="ResizeObserver" />
        </StackPanel>

        <ScrollView x:Name="ExamplesScroll" Grid.Column="1" Class="examples">
            <View x:Name="StackPage">
                <Text Class="section" Value="StackPanel" />
                <StackPanel Class="panel-box" Orientation="Horizontal" Spacing="8" Padding="12">
                    <Button Class="btn-action" Text="Save" />
                    <Button Class="btn-action" Text="Cancel" />
                </StackPanel>
                <Text Class="section" Value="Vertical with spacing" />
                <StackPanel Class="panel-box" Spacing="8" Padding="12">
                    <Text Class="scroll-line" Value="Children stack from top to bottom." />
                    <Text Class="scroll-line" Value="Spacing adds 8px between them." />
                    <Button Class="btn-action" Text="Keeps its own width" />
                </StackPanel>
            </View>

            <View x:Name="GridPage">
                <Text Class="section" Value="Grid" />
                <Grid Class="panel-box"
                      Rows="Auto,*"
                      Columns="140,*"
                      RowSpacing="8"
                      ColumnSpacing="12"
                      Padding="12">
                    <Text Class="grid-sidebar" Grid.RowSpan="2" Value="This sidebar spans two rows in a 140px column." />
                    <Text Class="grid-title" Grid.Column="1" Value="Dashboard" />
                    <Text Class="scroll-line" Grid.Row="1" Grid.Column="1" Value="This cell is in the star column, which takes the remaining width and wraps long text like this sentence." />
                </Grid>
            </View>

            <View x:Name="ScrollPage">
                <Text Class="section" Value="ScrollView" />
                <ScrollView x:Name="LogScroll" Class="scroll-box">
                    <Text Class="scroll-line" Value="Line 1: ScrollView clips and scrolls its content." />
                    <Text Class="scroll-line" Value="Line 2: Use the wheel or a trackpad over this box." />
                    <Text Class="scroll-line" Value="Line 3: Desktop draws an overlay scroll indicator." />
                    <Text Class="scroll-line" Value="Line 4: Web uses a real overflow on a div." />
                    <Text Class="scroll-line" Value="Line 5: The buttons below call ScrollTo." />
                    <Text Class="scroll-line" Value="Line 6: ScrollChanged updates the status line." />
                    <Text Class="scroll-line" Value="Line 7: Offsets stay inside the scrollable range." />
                    <Text Class="scroll-line" Value="Line 8: This is the end of the log." />
                </ScrollView>
                <Text x:Name="ScrollStatus" Class="scroll-status" Value="Scrolled 0px" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ScrollTopButton" Class="btn-action" Text="Scroll to top" />
                    <Button x:Name="ScrollBottomButton" Class="btn-action" Text="Scroll to bottom" />
                </StackPanel>

                <Text Class="section" Value="View with overflow-y: auto in CSS" />
                <View Class="overflow-box">
                    <Text Class="scroll-line" Value="This is a plain View." />
                    <Text Class="scroll-line" Value="Its stylesheet sets a height and overflow-y: auto." />
                    <Text Class="scroll-line" Value="It scrolls with no ScrollView and no C#." />
                    <Text Class="scroll-line" Value="Text can still be selected while scrolled." />
                    <Text Class="scroll-line" Value="This is the end of the notes." />
                </View>

                <Text Class="section" Value="Long text with a styled scrollbar" />
                <ScrollView Class="long-text-box">
                    <Text Class="long-text" Value="A single long Text wraps to the width of its ScrollView, and the wrapped height becomes the scrollable content. NativeUI lays this paragraph out with the shared Skia engine on desktop and as a real span in the browser on Web, so the same stylesheet controls both. This box uses scrollbar-color with theme variables and scrollbar-width: thin, which are standard CSS properties. On Web the browser draws the scrollbar from them, and on desktop the renderer reads the same values from the computed style. Keep scrolling to reach the end of this paragraph. Selecting text works while scrolled, because scrolling moves the layout boxes that hit-testing already uses. This is the last sentence of the long text example." />
                </ScrollView>

                <Text Class="section" Value="Horizontal scrolling" />
                <ScrollView x:Name="WideScroll" Class="wide-box">
                    <Text Class="wide-line" Value="This line is 900px wide, so this box scrolls sideways. Use a sideways swipe or the button below." />
                </ScrollView>
                <Button x:Name="ScrollRightButton" Class="btn-action" Text="Scroll right" />
            </View>

            <View x:Name="CanvasPage">
                <Text Class="section" Value="Shapes and opacity" />
                <CanvasView x:Name="ShapesCanvas" Class="canvas-box canvas-shapes" />

                <Text Class="section" Value="Transforms and clipping" />
                <CanvasView x:Name="TransformCanvas" Class="canvas-box canvas-transforms" />

                <Text Class="section" Value="Redrawing from data" />
                <CanvasView x:Name="ChartCanvas" Class="canvas-box canvas-chart" />
                <Button x:Name="ShuffleButton" Class="btn-action" Text="Shuffle data" />
            </View>

            <View x:Name="InputPage">
                <Text Class="section" Value="Two-way binding" />
                <Input x:Name="NameInput"
                       Class="field"
                       Placeholder="Type your name"
                       Value="{Binding UserName, Mode=TwoWay}" />
                <Text Class="scroll-status" Value="{Binding Greeting}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="FocusNameButton" Class="btn-action" Text="Focus the field" />
                    <Button Class="btn-action" Text="Clear" Command="{Binding ClearUserNameCommand}" />
                </StackPanel>
                <Text x:Name="FocusStatus" Class="scroll-status" Value="The field does not have focus" />

                <Text Class="section" Value="Read-only" />
                <Input Class="field" IsReadOnly="true" Value="This text can be selected and copied" />

                <Text Class="section" Value="Disabled" />
                <Input Class="field" IsEnabled="false" Value="This field does not respond" />
            </View>

            <DialogSampleView x:Name="DialogPage" />

            <AnimationSampleView x:Name="AnimationPage" />

            <Scene3DSampleView x:Name="Scene3DPage" />

            <View x:Name="ResizePage">
                <Text Class="section" Value="ResizeObserver &amp; Geometry Observation" />
                <Text Class="scroll-line" Value="Observes rendered dimensions on demand via ResizeObserver and size bindings." />

                <View x:Name="ResizeTargetBox" Class="panel-box">
                    <Text Class="scroll-line" Value="Target element observed on demand:" />
                    <Text x:Name="ResizeStatusText" Class="status" Value="Size: Unmeasured" />
                </View>

                <Text Class="section" Value="Adjust Target Dimensions" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ResizeCompactButton" Class="btn-action" Text="Compact (180px)" />
                    <Button x:Name="ResizeMediumButton" Class="btn-action" Text="Medium (320px)" />
                    <Button x:Name="ResizeWideButton" Class="btn-action" Text="Wide (460px)" />
                    <Button x:Name="ResizeToggleHeightButton" Class="btn-action" Text="Toggle Height" />
                </StackPanel>

                <Text Class="section" Value="Observation Lifecycle" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ToggleObserveButton" Class="btn-action" Text="Detach Observer" />
                </StackPanel>
                <Text x:Name="ObserverStateText" Class="scroll-status" Value="Observer Status: Active (Listening to SizeChanged)" />
            </View>
        </ScrollView>
    </Grid>
</View>
