<View xmlns="urn:nativeui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="NativeUI.Sample.HelloView"
      x:DataType="NativeUI.Sample.HelloViewModel"
      Class="card">

    <Text x:Name="BadgeText"
          Class="badge"
          Value="{Binding FrameworkBadge}" />

    <Text x:Name="TitleText"
          Class="title"
          Value="{Binding Title}" />

    <Text x:Name="SubtitleText"
          Class="subtitle"
          Value="{Binding Subtitle}" />

    <Text x:Name="StatusText"
          Class="status"
          Value="{Binding LiveStatus}" />
</View>
